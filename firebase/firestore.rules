rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.super_admin == true || 
        request.auth.token.email in ['yashgadge11155@gmail.com', 'yashgadge14@gmail.com', 'ygadge18@gmail.com', 'yash@gmail.com']
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || isSuperAdmin()
      );
    }
    
    function isVolunteer() {
      return isAuthenticated() && request.auth.token.volunteer == true;
    }
    
    // Resolving authorization source explicitly:
    // Custom claims are authoritative for basic role existence, but we also check status.
    // (In a real scenario, we might also verify the db document, but custom claims are more secure for fast reads.)
    
    function hasPermission(perm) {
      return isVolunteer() && request.auth.token.permissions != null && perm in request.auth.token.permissions;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function notUpdating(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // ------------------------------------------------------------------------
    // 1. IDENTITY
    // ------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isVolunteer();
      allow create: if isOwner(uid) && request.resource.data.role == 'PARTICIPANT' && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && notUpdating('uid') && notUpdating('role') && notUpdating('status') && notUpdating('createdAt');
      allow delete: if false; // Soft delete only
    }

    match /admins/{uid} {
      allow read: if isAdmin() || isVolunteer();
      allow write: if isSuperAdmin(); // Normal admin cannot write to admins
    }

    match /volunteers/{uid} {
      allow read: if isAdmin() || isOwner(uid) || hasPermission('VOLUNTEERS');
      allow write: if isAdmin(); // Volunteers cannot edit their own permissions/status
    }

    // ------------------------------------------------------------------------
    // 2. CONFIGURATION (Public Read)
    // ------------------------------------------------------------------------
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /formConfigs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /eventSettings/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // 3. PARTICIPANTS & REGISTRATION
    // ------------------------------------------------------------------------
    match /participants/{participantId} {
      allow read: if isAdmin() || isOwner(resource.data.uid) || isVolunteer();
      allow create: if isOwner(request.resource.data.uid) && request.resource.data.verificationStatus == 'PENDING';
      allow update: if isAdmin() || (isOwner(resource.data.uid) && notUpdating('uid') && notUpdating('verificationStatus') && notUpdating('createdAt'));
      allow delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if isAdmin() || isOwner(resource.data.uid) || isVolunteer();
      allow create: if isOwner(request.resource.data.uid)
                    && request.resource.data.status in ['DRAFT', 'SUBMITTED']
                    && request.resource.data.verificationStatus == 'PENDING'
                    && request.resource.data.passStatus == 'PENDING';
      
      allow update: if isAdmin() || (
        isOwner(resource.data.uid) 
        && notUpdating('uid') 
        && notUpdating('paymentId') 
        && notUpdating('passStatus')
        && notUpdating('amount')
        && notUpdating('currency')
        && notUpdating('verificationStatus')
        && notUpdating('createdAt')
        && request.resource.data.status in ['DRAFT', 'SUBMITTED', 'CANCELLED']
      );
      allow delete: if isAdmin();
    }
    
    match /registrationParticipants/{relationshipId} {
      allow read: if isAdmin() || isVolunteer() || (isAuthenticated() && get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.uid == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.uid == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.uid == request.auth.uid && notUpdating('registrationId'));
      allow delete: if isAdmin();
    }
    
    match /couples/{coupleId} {
      allow read: if isAdmin() || isVolunteer() || (isAuthenticated() && get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.uid == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.uid == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.uid == request.auth.uid && notUpdating('registrationId'));
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // 4. PAYMENTS & PASSES (Backend Authoritative)
    // ------------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin() || hasPermission('PAYMENTS') || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false; // Strict: Must be created/updated by Razorpay Webhook Cloud Functions
    }

    match /paymentEvents/{eventId} {
      allow read: if isAdmin() || isVolunteer();
      allow write: if false; // Immutable, Cloud Functions only
    }

    match /passes/{passId} {
      allow read: if isAdmin() || isVolunteer() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
    }
    
    match /complimentary_passes/{passId} {
      allow read: if isAdmin() || isVolunteer();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isVolunteer() && request.resource.data.checkInStatus == 'CHECKED_IN');
    }

    match /passEvents/{eventId} {
      allow read: if isAdmin() || isVolunteer();
      allow write: if false; // Immutable, Cloud Functions only
    }

    // ------------------------------------------------------------------------
    // 5. CHECK-INS
    // ------------------------------------------------------------------------
    match /checkins/{checkinId} {
      allow read: if isAdmin() || isVolunteer();
      allow write: if false; 
    }

    match /scannerSessions/{sessionId} {
      allow read, write: if isVolunteer() && request.resource.data.volunteerId == request.auth.uid;
      allow read: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // 6. LOGS & EXPORTS
    // ------------------------------------------------------------------------
    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /securityEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /exports/{exportId} {
      allow read: if isAdmin() && resource.data.requestedBy == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }
    
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow update: if isOwner(resource.data.uid) && notUpdating('uid') && notUpdating('message'); // allow marking read
      allow create, delete: if isAdmin();
    }

  }
}
