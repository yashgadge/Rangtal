rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.super_admin == true || 
        request.auth.token.email in ['yashgadge11155@gmail.com', 'yashgadge14@gmail.com', 'ygadge18@gmail.com', 'yash@gmail.com']
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || isSuperAdmin()
      );
    }

    function isVolunteer() {
      return isAuthenticated() && request.auth.token.volunteer == true;
    }

    function hasPermission(perm) {
      return isVolunteer() && request.auth.token.permissions != null && perm in request.auth.token.permissions;
    }
    
    // File Validation Functions
    function isValidImage() {
      return request.resource.contentType.matches('image/jpeg') || 
             request.resource.contentType.matches('image/png');
    }

    function isValidDocument() {
      return isValidImage() || request.resource.contentType.matches('application/pdf');
    }

    function isUnderSizeLimit(mb) {
      return request.resource.size <= (mb * 1024 * 1024);
    }

    // ------------------------------------------------------------------------
    // 1. PARTICIPANT FILES (ID Cards, Receipts)
    // ------------------------------------------------------------------------
    match /participants/{uid}/verification/{fileId} {
      allow read: if isOwner(uid) || isAdmin() || (isVolunteer() && hasPermission('VIEW_PARTICIPANT_DETAILS'));
      allow create, update: if isOwner(uid) && isValidDocument() && isUnderSizeLimit(5);
      allow delete: if isAdmin(); // Participants can overwrite (update), but not delete, preserving audit trail.
    }
    
    match /participants/{uid}/profile/{fileId} {
      allow read: if isOwner(uid) || isAdmin() || (isVolunteer() && hasPermission('VIEW_PARTICIPANT_BASIC'));
      allow create, update: if isOwner(uid) && isValidImage() && isUnderSizeLimit(5);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // 2. REGISTRATION DOCUMENTS
    // ------------------------------------------------------------------------
    match /registrations/{registrationId}/documents/{fileId} {
      // Realistically, to prove ownership we would need Firestore evaluation.
      // Since Storage rules cannot easily join Firestore without complex firestore.get() calls that cost reads,
      // we restrict registration uploads to Admin, OR we expect the client to use /participants/{uid} instead.
      // For now, restricted strictly to Admin. 
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // 3. PUBLIC EVENT ASSETS
    // ------------------------------------------------------------------------
    match /event-assets/public/{fileId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage() && isUnderSizeLimit(10);
    }

    // ------------------------------------------------------------------------
    // 4. ADMIN EXPORTS
    // ------------------------------------------------------------------------
    match /exports/{exportId}/{fileName} {
      // Only the requesting admin (if we tracked it in path) or Super Admin can read.
      allow read: if isSuperAdmin();
      allow write: if false; // Generated by Cloud Functions strictly
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
