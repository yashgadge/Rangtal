{
  "name": "rangtal-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "firebase/functions"
  ],
  "scripts": {
    "dev:public": "npm run dev --workspace=apps/public",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:vol": "npm run dev --workspace=apps/volunteer",
    "build:all": "npm run build --workspaces"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^14.5.0",
    "mocha": "^12.0.3",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "jimp": "^1.6.1"
  }
}
